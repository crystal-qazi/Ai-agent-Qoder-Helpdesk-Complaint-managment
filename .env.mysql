# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk_qoder
DB_USER=root
DB_PASSWORD=root

# MySQL Database URI (SQLAlchemy)
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/helpdesk_qoder

# Application Settings
APP_NAME=IT Software Complain System
APP_VERSION=1.0.0
MAX_CONTENT_LENGTH=16777216

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Security Settings
BCRYPT_LOG_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,txt,doc,docx,xls,xlsx

# Email Settings (optional for notifications)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log