# Flask
FLASK_APP=app:create_app
FLASK_ENV=development

# App security
SECRET_KEY=dev-only-change-this-secret-key-before-use

# MySQL connection (database selected automatically by FLASK_ENV)
DB_HOST=localhost
DB_PORT=3306
DB_USER=helpdesk_app
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

# Fixed targets:
# development -> helpdesk_qoder_dev
# production  -> Helpdesk_qoder_prod
# Do not set DATABASE_URL.

APP_NAME=IT Software Complain System
APP_VERSION=1.0.0
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,txt,doc,docx,xls,xlsx
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
